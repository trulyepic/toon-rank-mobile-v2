{
  "expo": {
    "name": "Toon Ranks",
    "slug": "toonranks-mobile",
    "scheme": "toonranks",
    "newArchEnabled": false,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#17110f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.toonranks.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17110f"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.toonranks.mobile",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "toonranks"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "photosPermission": "Toon Ranks needs access to your photo library to set your profile avatar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2999a815-1b7b-4cc0-b598-1648a3a41251"
      }
    },
    "owner": "toonranks"
  }
}

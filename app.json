{
  "expo": {
    "name": "Toon Ranks",
    "slug": "toonranks-mobile",
    "scheme": "toonranks",
    "newArchEnabled": false,
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#01033f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.toonranks.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17110f"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.toonranks.mobile",
      "versionCode": 3,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "toonranks"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "pathPrefix": "/series"
            },
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "pathPrefix": "/forum"
            },
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "pathPrefix": "/user"
            },
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "pathPrefix": "/lists"
            },
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "path": "/leaderboard"
            },
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "path": "/issues"
            },
            {
              "scheme": "https",
              "host": "www.toonranks.com",
              "path": "/report-issue"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "photosPermission": "Toon Ranks needs access to your photo library to set your profile avatar."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.33290208569-dnfbfbk5ebmbt7i7tu64o1p3msfvsmc3"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2999a815-1b7b-4cc0-b598-1648a3a41251"
      }
    },
    "owner": "toonranks"
  }
}

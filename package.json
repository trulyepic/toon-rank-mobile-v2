{
  "name": "toon-ranks-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier \"*.{js,ts,json,md,mjs}\" \"App.tsx\" \"src/**/*.{ts,tsx}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\" --check",
    "format:write": "prettier \"*.{js,ts,json,md,mjs}\" \"App.tsx\" \"src/**/*.{ts,tsx}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\" --write",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@tanstack/react-query": "^5.76.1",
    "axios": "^1.11.0",
    "expo": "~54.0.0",
    "expo-constants": "~17.1.7",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~9.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-recaptcha-that-works": "^2.0.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "^19.1.2",
    "babel-preset-expo": "^55.0.21",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.1",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}

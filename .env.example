# Copy this file to .env and fill in the values.

# Stable Toon Ranks backend API origin.
EXPO_PUBLIC_API_BASE_URL=https://api.toonranks.com

# Google reCAPTCHA v2 sitekey for native login/signup.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Google OAuth 2.0 client IDs for native Google Sign-In.
# Android client IDs are not referenced in app code — Google matches them automatically
# by package name + SHA-1 signing certificate. Both must exist in Google Cloud Console.
# Get these from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_DEBUG_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
